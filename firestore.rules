rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    function isChatParticipant(chatId) {
      return isAuthed()
        && get(/databases/$(database)/documents/chats/$(chatId)).data.participants
             .hasAny([request.auth.uid]);
    }

    function isHabitOwner(habitId) {
      return isAuthed()
        && get(/databases/$(database)/documents/habits/$(habitId)).data.userId
             == request.auth.uid;
    }

    // ── Users ──
    match /users/{uid} {
      allow read: if isAuthed();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // ── Chats ──
    match /chats/{chatId} {
      allow read: if isAuthed()
        && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if isAuthed()
        && request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if isAuthed()
        && resource.data.participants.hasAny([request.auth.uid]);
      allow delete: if isAuthed()
        && resource.data.participants.hasAny([request.auth.uid]);

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId);
        allow update: if isChatParticipant(chatId);
        allow delete: if isChatParticipant(chatId)
          && resource.data.senderId == request.auth.uid;
      }

      match /typing/{uid} {
        allow read: if isChatParticipant(chatId);
        allow write: if isOwner(uid);
      }
    }

    // ── Blog / Journal Posts ──
    match /posts/{postId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isAuthed() && resource.data.authorId == request.auth.uid;
      allow delete: if isAuthed() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuthed();
        allow create: if isAuthed();
        allow update: if isAuthed() && resource.data.authorId == request.auth.uid;
        allow delete: if isAuthed() && resource.data.authorId == request.auth.uid;
      }

      match /likes/{uid} {
        allow read: if isAuthed();
        allow write: if isOwner(uid);
      }
    }

    // ── Mood Tracker ──
    match /moods/{docId} {
      allow read: if isAuthed() && resource.data.userId == request.auth.uid;
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthed() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthed() && resource.data.userId == request.auth.uid;
    }

    // ── Habits ──
    match /habits/{habitId} {
      allow read: if isAuthed() && resource.data.userId == request.auth.uid;
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthed() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthed() && resource.data.userId == request.auth.uid;
    }

    // ── Habit Logs (subordinated to parent habit owner) ──
    match /habit_logs/{logId} {
      allow read: if isAuthed() && isHabitOwner(resource.data.habitId);
      allow create: if isAuthed() && isHabitOwner(request.resource.data.habitId);
      allow update: if isAuthed() && isHabitOwner(resource.data.habitId);
      allow delete: if isAuthed() && isHabitOwner(resource.data.habitId);
    }

    // ── Challenges ──
    match /challenges/{challengeId} {
      allow read: if isAuthed()
        && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if isAuthed();
      allow update: if isAuthed() && resource.data.createdBy == request.auth.uid;
      allow delete: if isAuthed() && resource.data.createdBy == request.auth.uid;
    }

    // ── Challenge Progress ──
    match /challenge_progress/{docId} {
      allow read: if isAuthed() && resource.data.userId == request.auth.uid;
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthed() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthed() && resource.data.userId == request.auth.uid;
    }

    // ── Reading List (reserved for future use — stored locally via Isar) ──
    match /readingList/{itemId} {
      allow read: if isAuthed() && resource.data.userId == request.auth.uid;
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthed() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthed() && resource.data.userId == request.auth.uid;
    }
  }
}
