rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    function isParticipant(chatId) {
      return isAuthed() && chatId.contains(request.auth.uid);
    }

    // ── Users ──
    match /users/{uid} {
      allow read: if isAuthed();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // ── Chats ──
    match /chats/{chatId} {
      allow read: if isAuthed() && chatId.contains(request.auth.uid);
      allow create: if isAuthed() && chatId.contains(request.auth.uid);
      allow update: if isAuthed() && chatId.contains(request.auth.uid);
      allow delete: if isAuthed() && chatId.contains(request.auth.uid);

      match /messages/{messageId} {
        allow read: if isAuthed() && chatId.contains(request.auth.uid);
        allow create: if isAuthed() && chatId.contains(request.auth.uid);
        allow update: if isAuthed() && chatId.contains(request.auth.uid);
        allow delete: if isAuthed() && chatId.contains(request.auth.uid);
      }

      match /typing/{uid} {
        allow read: if isAuthed() && chatId.contains(request.auth.uid);
        allow write: if isOwner(uid);
      }
    }

    // ── Blog / Journal Posts ──
    match /posts/{postId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isAuthed() && resource.data.authorId == request.auth.uid;
      allow delete: if isAuthed() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuthed();
        allow create: if isAuthed();
        allow update: if isAuthed() && resource.data.authorId == request.auth.uid;
        allow delete: if isAuthed() && resource.data.authorId == request.auth.uid;
      }

      match /likes/{uid} {
        allow read: if isAuthed();
        allow write: if isOwner(uid);
      }
    }

    // ── Mood Tracker ──
    match /moods/{docId} {
      allow read: if isAuthed() && docId.contains(request.auth.uid);
      allow create: if isAuthed() && docId.contains(request.auth.uid);
      allow update: if isAuthed() && docId.contains(request.auth.uid);
      allow delete: if isAuthed() && docId.contains(request.auth.uid);
    }

    // ── Habits ──
    match /habits/{habitId} {
      allow read: if isAuthed() && resource.data.userId == request.auth.uid;
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthed() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthed() && resource.data.userId == request.auth.uid;
    }

    match /habitLogs/{logId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isAuthed();
      allow delete: if isAuthed();
    }

    // ── Challenges ──
    match /challenges/{challengeId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isAuthed();
      allow delete: if isAuthed();
    }

    // ── Reading List ──
    match /readingList/{itemId} {
      allow read: if isAuthed() && resource.data.userId == request.auth.uid;
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthed() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthed() && resource.data.userId == request.auth.uid;
    }
  }
}
